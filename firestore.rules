rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document rule
    match /test/connection {
      allow read: if true;
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      // Deny blanket listing of user profiles to prevent scraping
      allow list: if false;

      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;

      allow delete: if isOwner(userId);

      // Private PII subcollection: strictly isolated to the owner
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Active Devices Subcollection (Multi-Device Management)
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Conversations Subcollection
      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;

        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;

        allow delete: if isOwner(userId);

        // Messages Subcollection
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow list: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.userId == userId
            && request.resource.data.role in ['user', 'assistant']
            && request.resource.data.content is string;

          allow update: if isOwner(userId)
            && request.resource.data.userId == userId;

          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
